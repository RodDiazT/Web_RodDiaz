# Base de datos (PostgreSQL en Railway)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/railway

# Secreto de Payload (mínimo 32 caracteres)
PAYLOAD_SECRET=ejemplo_secreto_payload_debe_tener_al_menos_32_caracteres_aleatorios

# URL canónica del sitio (sin barra final)
URL_SITIO=https://pruebas-web-roddiaz.up.railway.app

# Entorno: pruebas o production
ENTORNO=pruebas

# Administrador único
CORREO_ADMIN=rodrigodiaztapia@gmail.com

# Autenticación Google OAuth (opcional en desarrollo inicial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificaciones push por Bot de Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zona horaria del servidor
TZ=UTC
