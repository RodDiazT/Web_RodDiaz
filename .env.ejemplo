# ==============================================================================
# Variables de entorno — Web_RodDiaz (Railway / Desarrollo)
# Especificado en DocumentosTecnicos/plataforma/despliegue.md (§5.5)
# ==============================================================================

# Base de datos PostgreSQL (en Railway: ${{postgres.DATABASE_URL}})
DATABASE_URL=postgresql://usuario:contraseña@host:5432/railway

# Clave secreta criptográfica de Payload (aleatoria, mín. 32 caracteres)
# En pruebas debe ser DISTINTA a la de producción para aislar sesiones
PAYLOAD_SECRET=cambiar_por_secreto_aleatorio_de_al_menos_32_caracteres_1234567890

# Correos de administradores autorizados (separados por coma si son varios)
CORREOS_ADMIN=rodrigodiaztapia@gmail.com

# URL canónica base del sitio (sin barra final)
# En producción: https://${{RAILWAY_PUBLIC_DOMAIN}} (o el dominio propio en v1.x)
URL_SITIO=https://roddiaz.up.railway.app

# Ruta de montaje del volumen persistente para medios e imágenes
# En Railway: ${{RAILWAY_VOLUME_MOUNT_PATH}}
RUTA_MEDIOS=./medios

# Entorno: "produccion" (indexable) o "pruebas" (noindex, duerme sin uso)
ENTORNO=pruebas

# Habilitar ejecución de tareas automáticas en segundo plano (purgas)
# En producción: true. En pruebas: false (para permitir que el servicio duerma)
TAREAS_AUTOMATICAS=false

# Desactivar telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1

# Zona horaria del servidor (UTC estricto para evitar desfases de horario de verano)
TZ=UTC

# Cliente OAuth de Google Cloud para inicio de sesión en /admin (T-008)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bot de Telegram para avisos push instantáneos de consultas (opcional, T-014)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
